# ============================================================
# SENTINEL — Environment Configuration
# Copy to .env and adjust values for your deployment
# ============================================================

# --- Network Capture ---
CAPTURE_INTERFACE=wlan0
BPF_FILTER=
PCAP_SNAPLEN=65535

# --- Flow Tracking ---
FLOW_TIMEOUT_ACTIVE=120
FLOW_TIMEOUT_IDLE=30
FLOW_CLEANUP_INTERVAL=10

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CHANNEL_FLOWS=sentinel:flows
REDIS_CHANNEL_PACKETS=sentinel:packets
REDIS_CHANNEL_DISCOVERY=sentinel:discovery
REDIS_CHANNEL_STATS=sentinel:stats

# --- DPI (NFStream) ---
ENABLE_DPI=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Stats ---
STATS_INTERVAL=10
