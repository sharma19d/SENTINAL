<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the UI; this only sets the window before the first frame.
         Homora uses one dark look, so the window is dark from the very first frame. -->
    <style name="Theme.Homora" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Shown by the system while the app starts: the logo on the app's background. -->
    <style name="Theme.Homora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Homora</item>
    </style>
</resources>
